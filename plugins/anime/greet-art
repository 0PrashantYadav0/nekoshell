#!/usr/bin/env bash
# anime greet-art: a random sprite from the anime-colorscripts pack, captioned
# with the character's name. The pack's own launcher is not used: it wants
# GNU coreutils on macOS, and picking a file needs neither it nor them.
#
# The candidates come from .nekoshell-list.txt, which the install hook writes
# with the sprites that fit next to the stats (some in the pack are 250
# columns wide). Filtering runs on that list with a few pipes rather than a
# process per file: 247 files, two processes each, is half a second, and
# the greeting has 150 ms for everything.
#
# Keys from greet.conf: ANIME_ONLY (words; only names containing one are
# drawn), ANIME_SKIP (words never drawn; the pack has one crude name) and
# ANIME_SCALE (percent of the pack's size to draw at, 30 unless set).
set -uo pipefail
base="$HOME/.local/share/anime-colorscripts"
dir="$base/colorscripts"
[[ -d "$dir" ]] || exit 1
[[ -n "${NEKOSHELL_SEED:-}" ]] && RANDOM="$NEKOSHELL_SEED"

if [[ -s "$base/.nekoshell-list.txt" ]]; then
  candidates="$(cat "$base/.nekoshell-list.txt")"
else
  candidates="$(find "$dir" -maxdepth 1 -name '*.txt' | sed 's|.*/||; s/\.txt$//' | sort)"
fi
for word in ${ANIME_SKIP-fuck}; do
  candidates="$(printf '%s\n' "$candidates" | grep -iv -e "$word" || true)"
done
if [[ -n "${ANIME_ONLY:-}" ]]; then
  args=()
  for word in $ANIME_ONLY; do args+=(-e "$word"); done
  candidates="$(printf '%s\n' "$candidates" | grep -i "${args[@]}" || true)"
fi
names=()
while IFS= read -r n; do
  [[ -n "$n" && -f "$dir/$n.txt" ]] && names+=("$n")
done <<<"$candidates"
[[ ${#names[@]} -gt 0 ]] || exit 1
name="${names[$((RANDOM % ${#names[@]}))]}"
caption="${name#[0-9]*-}"
caption="${caption#[0-9]*_}"
printf '%s\n' "$caption" | tr '_-' '  ' | awk '{ for (i = 1; i <= NF; i++) $i = toupper(substr($i, 1, 1)) substr($i, 2) } 1'

# The pack draws every character 32 rows tall, which is three times the
# stats block beside it, so the sprite is shrunk before it is printed. A
# sprite is a grid of cells, each a colour escape (or none, when the colour
# runs on from the cell before) and then two spaces or two full blocks, so
# shrinking is picking cells: the row and column from the middle of each
# block of the original, every kept cell carrying its own colour. One awk
# over 32 lines is a few milliseconds of the greeting's 150 ms.
scale="${ANIME_SCALE:-30}"
[[ "$scale" =~ ^[0-9]+$ && "$scale" -ge 1 && "$scale" -le 100 ]] || scale=30
if [[ "$scale" -eq 100 ]]; then
  cat "$dir/$name.txt"
  exit 0
fi
awk -v scale="$scale" '
  # Blank lines above and below the sprite are padding, not rows.
  /^[[:space:]]*$/ { next }
  { rows[++h] = $0 }
  END {
    n = int(h * scale / 100 + 0.5)
    if (n < 1) n = 1
    # Whatever follows the last cell of the last row, the reset that ends
    # the sprites in the pack, ends the shrunk one too, whichever rows it keeps.
    last = rows[h]
    w = gsub(/(  |██)/, "&\001", last)
    split(last, cell, "\001")
    tail = cell[w + 1]
    for (r = 0; r < n; r++) {
      line = rows[int((r + 0.5) * h / n) + 1]
      w = gsub(/(  |██)/, "&\001", line)
      split(line, cell, "\001")
      # A line that is not cells at all is not the pack; leave it alone.
      if (w == 0) {
        print (r == n - 1) ? line tail : line
        continue
      }
      m = int(w * scale / 100 + 0.5)
      if (m < 1) m = 1
      esc = ""
      out = ""
      k = 0
      for (c = 1; c <= w; c++) {
        # match() rather than length arithmetic: the blocks are one
        # character to an awk that reads UTF-8 and three bytes to one that
        # does not, and RSTART is right either way.
        match(cell[c], /(  |██)$/)
        lead = substr(cell[c], 1, RSTART - 1)
        pair = substr(cell[c], RSTART)
        if (lead != "") esc = lead
        if (c == int((k + 0.5) * w / m) + 1 && k < m) {
          out = out esc pair
          k++
        }
      }
      if (r == n - 1) out = out tail
      print out
    }
  }
' "$dir/$name.txt"
