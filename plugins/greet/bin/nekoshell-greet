#!/usr/bin/env bash
# nekoshell-greet: art + machine stats for a new interactive terminal.
# Never fails a fresh shell: every problem exits 0 quietly.
set -uo pipefail

# The tty check is about the automatic greeting only: a shell startup that is
# not looking at a terminal (a script, a command substitution) must not have a
# picture pushed into its output. Someone who typed `nekoshell greet` asked for
# it, and asking for it sets NEKOSHELL_GREET_MODE, so `nekoshell greet --text
# | cat` prints rather than silently doing nothing.
[[ -t 1 || -n "${NEKOSHELL_GREET_MODE:-}" ]] || exit 0
[[ -n "${NEKOSHELL_NO_GREET:-}" ]] && exit 0
[[ -n "${CLAUDECODE:-}" ]] && exit 0
[[ -n "${TMUX:-}" ]] && exit 0
[[ -n "${NEKOSHELL_PANEL:-}" ]] && exit 0
# Exactly 1, the same value late.zsh looks for: NEKOSHELL_GREET_SSH=0 reads as
# "no" to anyone who writes it, and a knob that means yes either way is worse
# than no knob at all.
if [[ -n "${SSH_CONNECTION:-}" && "${NEKOSHELL_GREET_SSH:-}" != 1 ]]; then exit 0; fi

command -v fastfetch >/dev/null 2>&1 || exit 0

# now_ms: current time in whole milliseconds. macOS `date` has no %N, so this
# shells out to python3. Only called when NEKOSHELL_GREET_TIME is set, so the
# normal greeting path never invokes python.
now_ms() {
  python3 -c 'import time;print(int(time.time()*1000))'
}

start_ms=""
[[ -n "${NEKOSHELL_GREET_TIME:-}" ]] && start_ms="$(now_ms)"

# The plugin's own directory, from this script rather than from anything
# recorded: the sample art belongs to the copy that is running. A relative
# link target is relative to the link's own directory, not to $PWD, and a
# link can point at another link; both are resolved here the same way
# bin/nekoshell does it.
_greet_self="${BASH_SOURCE[0]}"
_greet_hops=0
while [[ -L "$_greet_self" && "$_greet_hops" -lt 16 ]]; do
  _greet_target="$(readlink "$_greet_self")"
  case "$_greet_target" in
    /*) _greet_self="$_greet_target" ;;
    *) _greet_self="$(cd "$(dirname "$_greet_self")" && pwd -P)/$_greet_target" ;;
  esac
  _greet_hops=$((_greet_hops + 1))
done
PLUGIN_DIR="${PLUGIN_DIR:-$(cd "$(dirname "$_greet_self")/.." 2>/dev/null && pwd -P)}"
[[ -n "$PLUGIN_DIR" ]] || exit 0
export PLUGIN_DIR

# The checkout: whatever the environment says, else the root nekoshell.toml
# records. A greeting never complains, so a root that cannot be found means
# the terminal question below is simply left unanswered.
if [[ -z "${NEKOSHELL_ROOT:-}" ]] && [[ -r "$HOME/.config/nekoshell/nekoshell.toml" ]]; then
  NEKOSHELL_ROOT="$(sed -n 's/^root *= *"\(.*\)"/\1/p' "$HOME/.config/nekoshell/nekoshell.toml" | head -1)"
fi
export NEKOSHELL_ROOT="${NEKOSHELL_ROOT:-}"

NEKOSHELL_CONFIG="$HOME/.config/nekoshell"
NEKOSHELL_CACHE="$HOME/.cache/nekoshell"
NEKOSHELL_PLUGINS_DIR="${NEKOSHELL_PLUGINS_DIR:-$NEKOSHELL_ROOT/plugins}"
export NEKOSHELL_CONFIG NEKOSHELL_CACHE NEKOSHELL_PLUGINS_DIR

# greet.conf: the engine's own keys, and any an art provider reads. It is
# sourced with everything exported, so a provider (a separate process) sees
# the same keys without parsing the file again.
ART="auto"
SPRITE_SHARE=""
POKEMON_SHARE=""
IMAGE_WIDTH=28
IMAGE_HEIGHT=14
set -a
if [[ -r "$NEKOSHELL_CONFIG/greet.conf" ]]; then
  # shellcheck source=/dev/null
  source "$NEKOSHELL_CONFIG/greet.conf"
fi
set +a
# SPRITE_SHARE used to be POKEMON_SHARE, when the Pokémon was the only sprite.
[[ -n "$SPRITE_SHARE" ]] || SPRITE_SHARE="${POKEMON_SHARE:-70}"

[[ -n "${NEKOSHELL_SEED:-}" ]] && RANDOM="$NEKOSHELL_SEED"
mkdir -p "$NEKOSHELL_CACHE"
ff_config="$HOME/.config/fastfetch/config.jsonc"

# image_flag: the fastfetch flag that draws an inline image in this terminal,
# or nothing at all when it cannot draw one. The question is put to the
# terminal adapter, never to TERM_PROGRAM: an iTerm2 window running inside
# something else, or a terminal that sets no TERM_PROGRAM at all, would both
# get the wrong answer from the variable. iTerm2 has an image protocol of its
# own; everything else that can draw images speaks kitty's.
image_flag() {
  local term caps c
  [[ -n "$NEKOSHELL_ROOT" ]] || return 0
  for c in log paths config terminal; do
    [[ -r "$NEKOSHELL_ROOT/core/lib/$c.sh" ]] || return 0
  done
  # shellcheck source=/dev/null
  source "$NEKOSHELL_ROOT/core/lib/log.sh" 2>/dev/null || return 0
  # shellcheck source=/dev/null
  source "$NEKOSHELL_ROOT/core/lib/paths.sh" 2>/dev/null || return 0
  # shellcheck source=/dev/null
  source "$NEKOSHELL_ROOT/core/lib/config.sh" 2>/dev/null || return 0
  # shellcheck source=/dev/null
  source "$NEKOSHELL_ROOT/core/lib/terminal.sh" 2>/dev/null || return 0
  term="$(terminal_current 2>/dev/null || true)"
  [[ -n "$term" ]] || return 0
  terminal_load "$term" >/dev/null 2>&1 || return 0
  caps="$(terminal_capabilities 2>/dev/null || true)"
  for c in $caps; do
    [[ "$c" == "images" ]] || continue
    if [[ "$term" == "iterm2" ]]; then printf '%s\n' "--iterm"; else printf '%s\n' "--kitty"; fi
    return 0
  done
  return 0
}

pick_image() {
  # Print a random image path from the art pack, or nothing.
  local files=() f
  for f in "$NEKOSHELL_CONFIG"/art/*.png "$NEKOSHELL_CONFIG"/art/*.jpg "$NEKOSHELL_CONFIG"/art/*.jpeg; do
    [[ -f "$f" ]] && files+=("$f")
  done
  [[ ${#files[@]} -eq 0 ]] && return 0
  printf '%s\n' "${files[$((RANDOM % ${#files[@]}))]}"
}

# enabled_plugins: the names on the plugins line of nekoshell.toml, in order.
# Read with sed rather than the core config library, which would cost the
# greeting a few more sourced files on every shell.
enabled_plugins() {
  local toml="$NEKOSHELL_CONFIG/nekoshell.toml" line
  [[ -r "$toml" ]] || return 0
  line="$(sed -n 's/^plugins[[:space:]]*=[[:space:]]*\[\(.*\)\].*/\1/p' "$toml" | head -1)"
  printf '%s\n' "$line" | tr ',' '\n' | tr -d '" ' | sed '/^$/d'
  return 0
}

# providers: the enabled plugins that ship an executable greet-art, in the
# order they were enabled. That file is the whole of the provider contract:
# the caption on the first line, the sprite after it, silence and a non-zero
# status when there is nothing to draw.
providers() {
  local p
  for p in $(enabled_plugins); do
    [[ -x "$NEKOSHELL_PLUGINS_DIR/$p/greet-art" ]] && printf '%s\n' "$p"
  done
  return 0
}

# pick_provider: one provider name by ART, or nothing when none applies.
# "auto" gives every enabled provider the same odds. A list such as
# "pokemon:70,anime:30" weights them; a name without a weight counts 1, a
# name that is not an enabled provider is dropped, and a weight of 0 never
# draws.
pick_provider() {
  local names=() weights=() total=0 entry name w p roll acc i avail
  if [[ -z "$ART" || "$ART" == "auto" ]]; then
    for p in $(providers); do
      names+=("$p")
      weights+=(1)
      total=$((total + 1))
    done
  else
    avail=" $(providers | tr '\n' ' ')"
    for entry in ${ART//,/ }; do
      name="${entry%%:*}"
      w="${entry#*:}"
      [[ "$w" == "$entry" ]] && w=1
      [[ "$w" =~ ^[0-9]+$ ]] || w=1
      [[ "$avail" == *" $name "* ]] || continue
      ((w > 0)) || continue
      names+=("$name")
      weights+=("$w")
      total=$((total + w))
    done
  fi
  [[ ${#names[@]} -gt 0 ]] || return 0
  roll=$((RANDOM % total))
  acc=0
  for i in "${!names[@]}"; do
    acc=$((acc + weights[i]))
    if ((roll < acc)); then
      printf '%s\n' "${names[i]}"
      return 0
    fi
  done
}

# show_sprite NAME: run NAME's greet-art and hand fastfetch the sprite. The
# caption goes to the cache for the "Art" row. A provider that prints nothing
# usable fails this, and the caller shows the stats alone.
show_sprite() {
  local name="$1" out
  out="$(PLUGIN_NAME="$name" PLUGIN_DIR="$NEKOSHELL_PLUGINS_DIR/$name" \
    "$NEKOSHELL_PLUGINS_DIR/$name/greet-art" 2>/dev/null)" || return 1
  [[ "$out" == *$'\n'* ]] || return 1
  printf '%s\n' "${out%%$'\n'*}" >"$NEKOSHELL_CACHE/art-name"
  printf '%s\n' "${out#*$'\n'}" | fastfetch --config "$ff_config" --file-raw -
}

# show_stats: the machine stats with no picture, which is still a greeting.
show_stats() {
  : >"$NEKOSHELL_CACHE/art-name"
  fastfetch --config "$ff_config" --logo none </dev/null
}

show_image() {
  local img="$1" flag="$2"
  basename "$img" >"$NEKOSHELL_CACHE/art-name"
  fastfetch --config "$ff_config" "$flag" "$img" --logo-width "$IMAGE_WIDTH" --logo-height "$IMAGE_HEIGHT" </dev/null
}

# The roll is taken whatever the mode, so a forced greeting and an automatic
# one draw the same sprite from the same seed.
roll=$((RANDOM % 100))
img=""
flag=""
mode="${NEKOSHELL_GREET_MODE:-auto}"
[[ -n "${NEKOSHELL_GREET_ART:-}" ]] && mode=text
case "$mode" in
  text) ;;
  image)
    flag="$(image_flag)"
    [[ -n "$flag" ]] && img="$(pick_image)"
    ;;
  *) if ((roll >= SPRITE_SHARE)); then
    flag="$(image_flag)"
    [[ -n "$flag" ]] && img="$(pick_image)"
  fi ;;
esac

if [[ -n "$img" ]]; then
  show_image "$img" "$flag"
else
  provider="${NEKOSHELL_GREET_ART:-}"
  [[ -n "$provider" ]] || provider="$(pick_provider)"
  if [[ -z "$provider" ]] || ! show_sprite "$provider"; then
    show_stats
  fi
fi

if [[ -n "${NEKOSHELL_GREET_TIME:-}" ]]; then
  end_ms="$(now_ms)"
  printf 'greet: %d ms\n' $((end_ms - start_ms))
fi
exit 0
