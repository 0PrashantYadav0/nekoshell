#!/usr/bin/env bash
# Fake tmux: enough for the doctor's tool row, for `command -v tmux`, and for
# the default terminal_panel's tmux popup. It never starts a server, so a
# test can never attach to the real terminal. With no arguments it prints a
# fixed version string; with arguments it echoes the invocation, so a test
# can assert on the popup command it built.
if [[ $# -gt 0 ]]; then
  echo "tmux $*"
else
  echo "tmux 0.0-nekoshell-fake"
fi
