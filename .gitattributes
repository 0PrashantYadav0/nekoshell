# Line endings: LF everywhere (scripts/lint.sh refuses CRLF anyway).
* text=auto eol=lf

# Out of the release tarball (git archive): development-only files.
.github export-ignore
.githooks export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.planning export-ignore
.editorconfig export-ignore
.markdownlint-cli2.yaml export-ignore
.shellcheckrc export-ignore
.yamllint.yaml export-ignore

# Also out of the tarball: nothing at runtime opens these, only contributors
# and the repository page do. What is left is what Homebrew installs into
# libexec. The four directory patterns are anchored to the repository root
# (a leading /) so they only match the top-level directory, not any deeper
# path that happens to share the name, such as plugins/greet/scripts/ or
# plugins/pokemon/scripts/ (their own generator scripts, listed below by
# their own explicit lines instead, so they still leave the tarball).
/tests export-ignore
/scripts export-ignore
/skills export-ignore
/packaging export-ignore
/site export-ignore
docs/superpowers export-ignore
docs/ci-checks export-ignore
docs/contributing export-ignore
docs/ai export-ignore
docs/screenshots export-ignore
docs/assets export-ignore
Makefile export-ignore
AGENTS.md export-ignore
CLAUDE.md export-ignore
CONTRIBUTING.md export-ignore
CODE_OF_CONDUCT.md export-ignore
SECURITY.md export-ignore
llms.txt export-ignore

# These two plugins also have their own scripts/ directory: generator
# scripts (gen-sample-art.py, gen-pokemon-data.py) run by contributors, not
# at runtime. The unanchored "scripts" pattern used to catch these too by
# matching at any depth; now that it is anchored to the root, they need
# their own lines to stay out of the tarball as before.
plugins/greet/scripts export-ignore
plugins/pokemon/scripts export-ignore
