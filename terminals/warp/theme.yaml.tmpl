# nekoshell: Catppuccin @@TITLE@@ for Warp, rendered from core/theme/palettes.json.
# Changed by `nekoshell theme <flavour>`, not by hand: the next theme switch
# overwrites this file. `details` and any background image are appended below
# by terminals/warp/adapter.sh, because they are not colours.
name: nekoshell @@FLAVOR@@
accent: '@@HEX:mauve@@'
cursor: '@@HEX:rosewater@@'
background: '@@HEX:base@@'
foreground: '@@HEX:text@@'
terminal_colors:
  normal:
    black: '@@HEX:ansiblack@@'
    red: '@@HEX:ansired@@'
    green: '@@HEX:ansigreen@@'
    yellow: '@@HEX:ansiyellow@@'
    blue: '@@HEX:ansiblue@@'
    magenta: '@@HEX:ansimagenta@@'
    cyan: '@@HEX:ansicyan@@'
    white: '@@HEX:ansiwhite@@'
  bright:
    black: '@@HEX:ansibrblack@@'
    red: '@@HEX:ansibrred@@'
    green: '@@HEX:ansibrgreen@@'
    yellow: '@@HEX:ansibryellow@@'
    blue: '@@HEX:ansibrblue@@'
    magenta: '@@HEX:ansibrmagenta@@'
    cyan: '@@HEX:ansibrcyan@@'
    white: '@@HEX:ansibrwhite@@'
