# nekoshell: Catppuccin @@TITLE@@ for Warp, rendered from core/theme/palettes.json.
# Changed by `nekoshell theme <flavour>`, not by hand: the next theme switch
# overwrites this file. `details` and any background image are appended below
# by terminals/warp/adapter.sh, because they are not colours.
name: nekoshell @@FLAVOR@@
accent: '@@HEX:mauve@@'
cursor: '@@HEX:rosewater@@'
background: '@@HEX:base@@'
foreground: '@@HEX:text@@'
terminal_colors:
  normal:
    black: '@@HEX:surface1@@'
    red: '@@HEX:red@@'
    green: '@@HEX:green@@'
    yellow: '@@HEX:yellow@@'
    blue: '@@HEX:blue@@'
    magenta: '@@HEX:pink@@'
    cyan: '@@HEX:teal@@'
    white: '@@HEX:subtext1@@'
  bright:
    black: '@@HEX:surface2@@'
    red: '@@HEX:red@@'
    green: '@@HEX:green@@'
    yellow: '@@HEX:yellow@@'
    blue: '@@HEX:blue@@'
    magenta: '@@HEX:pink@@'
    cyan: '@@HEX:teal@@'
    white: '@@HEX:subtext0@@'
