#!/usr/bin/env bash
# commit-msg: refuse a message that is not a conventional commit. Installed by
# `make hooks`. The rules live in scripts/check-commit-msg.sh, which CI runs
# over every commit of a pull request, so a message this hook lets through
# is one CI accepts too.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-commit-msg.sh" "$1" || {
  echo >&2
  echo "commit-msg: see CONTRIBUTING.md, section Commit messages (sign off with git commit -s)" >&2
  exit 1
}
