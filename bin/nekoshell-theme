#!/usr/bin/env bash
# nekoshell-theme: switch the rig between Catppuccin flavours.
set -euo pipefail
# The checkout is this script's own directory, so the templates and the palette
# come from the copy you actually ran, whatever ~/.config/nekoshell/root records.
NEKOSHELL_ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd -P)"
export NEKOSHELL_ROOT
# shellcheck source=lib/log.sh
source "$NEKOSHELL_ROOT/lib/log.sh"
# shellcheck source=lib/paths.sh
source "$NEKOSHELL_ROOT/lib/paths.sh"
# shellcheck source=lib/backup.sh
source "$NEKOSHELL_ROOT/lib/backup.sh"
# shellcheck source=lib/iterm.sh
source "$NEKOSHELL_ROOT/lib/iterm.sh"
# shellcheck source=lib/theme.sh
source "$NEKOSHELL_ROOT/lib/theme.sh"

usage() {
  cat <<'EOF'
usage: nekoshell-theme <command>
  <flavour>     switch to it: latte, frappe, macchiato or mocha
  list          the flavours you can switch to
  current       the flavour in force
EOF
}

case "${1:-}" in
  list) theme_flavors ;;
  current) theme_current ;;
  -h|--help) usage ;;
  "") usage; exit 2 ;;
  *)
    if ! theme_is_flavor "$1"; then
      log_fail "unknown flavour: $1"
      echo "known flavours:" >&2
      theme_flavors >&2
      exit 1
    fi
    # Rendering is quiet on success; `run` would print a python command line
    # nobody needs to read to know the colours changed.
    theme_render "$1" >/dev/null
    log_ok "theme: $1. Open a new terminal window for the prompt and greeting; iTerm2 reloads the profile colours on its own."
    ;;
esac
