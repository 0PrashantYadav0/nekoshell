# nekoshell Starship config. This file (core/starship/starship.toml.tmpl) is
# the source; `nekoshell theme` renders it to ~/.config/starship.toml with the
# chosen flavour substituted into the palette line below. Edits to the rendered
# copy are lost on the next flavour switch. The palette tables come from
# core/theme/palettes.json, generated by core/theme/gen-palettes.py.
"$schema" = 'https://starship.rs/config-schema.json'
add_newline = true
palette = "catppuccin_@@FLAVOR@@"

format = """
$directory$git_branch$git_status$git_state$nodejs$python$rust$golang$docker_context$fill$cmd_duration$status$jobs$time$line_break$character"""

